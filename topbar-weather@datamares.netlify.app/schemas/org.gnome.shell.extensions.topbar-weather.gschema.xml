<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.topbar-weather"
    path="/org/gnome/shell/extensions/topbar-weather/">
    <key name="weather-after-clock" type="b">
      <default>false</default>
    </key>
    <key name="show-apparent-temp" type="b">
      <default>false</default>
    </key>
    <key name="hide-units" type="b">
      <default>false</default>
    </key>
    <key name="hide-apparent-decimals" type="b">
      <default>false</default>
      <summary>Hide decimals in apparent temperature</summary>
      <description>When enabled, rounds apparent temperature to nearest integer</description>
    </key>
    <key name="show-conditions" type="b">
      <default>false</default>
      <summary>Show weather conditions</summary>
      <description>When enabled, shows written weather conditions (e.g., rain, drizzle). If no active weather, shows sky description (e.g., partly cloudy, overcast)</description>
    </key>
  </schema>
</schemalist>
